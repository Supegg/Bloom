<Window x:Class="Bloom.DesignTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bloom.DesignTime"
        mc:Ignorable="d"
        Title="运行时示例" 
        d:Title="设计时预览"
        Height="450" Width="800">
    <Window.Resources>
        <!--定义设计时预览用资源-->
        <local:Hammer x:Key="DesignHammer">
            <local:Hammer.Name>铁锤</local:Hammer.Name>
            <local:Hammer.Size>10</local:Hammer.Size>
            <local:Hammer.Nails>
                <local:Nail Material="steel" Length="1"></local:Nail>
                <local:Nail Material="cotton" Length="2"></local:Nail>
                <local:Nail Material="plastic" Length="3"></local:Nail>
            </local:Hammer.Nails>
        </local:Hammer>

    </Window.Resources>
    <Canvas>
        <TextBlock Text="运行时文本" d:Text="设计时预览" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   FontSize="24" Canvas.Left="300" Canvas.Top="35"/>

        <TextBlock Text="{Binding Name}" d:Text="{Binding Source={StaticResource DesignHammer}, Path=Name}" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   FontSize="24" Canvas.Left="300" Canvas.Top="75"/>
        <TextBlock Text="{Binding Size}" d:Text="{Binding Source={StaticResource DesignHammer}, Path=Size}"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   FontSize="24" Canvas.Left="300" Canvas.Top="110" />

        <DataGrid ItemsSource="{Binding Nails}" d:ItemsSource="{Binding Source={StaticResource DesignHammer}, Path=Nails}" Canvas.Left="300" Canvas.Top="150" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="材料" Binding="{Binding Material}" />
                <DataGridTextColumn Header="长度" Binding="{Binding Length}" />
            </DataGrid.Columns>
        </DataGrid>
    </Canvas>
</Window>
